{
  "name": "@adrianlzt/opencode-telegram",
  "version": "0.2.0",
  "description": "OpenCode plugin: chat with sessions via Telegram forum topics (one topic per session)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "install-plugin": "tsup && cp dist/index.js ~/.config/opencode/plugins/telegram.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
